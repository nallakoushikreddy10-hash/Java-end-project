
import java.io.*;
import java.time.LocalDate;
import java.util.*;

// ================= TRANSACTION CLASS =================

class Transaction implements Serializable {
    private static final long serialVersionUID = 1L;

    private int transactionId;
    private String type;
    private double amount;
    private LocalDate date;

    public Transaction(int id, String type, double amount) {
        this.transactionId = id;
        this.type = type;
        this.amount = amount;
        this.date = LocalDate.now();
    }

    public int getTransactionId() {
        return transactionId;
    }

    public String getType() {
        return type;
    }

    public double getAmount() {
        return amount;
    }

    public LocalDate getDate() {
        return date;
    }

    public String toString() {
        return transactionId + " | " + type +
                " | Rs. " + amount + " | " + date;
    }
}

// ================= BANK ACCOUNT CLASS =================

class BankAccount implements Serializable {
    private static final long serialVersionUID = 1L;

    private int accountNumber;
    private String customerName;
    private double balance;

    private ArrayList<Transaction> transactions =
            new ArrayList<>();

    public BankAccount(int accountNumber,
                       String customerName,
                       double balance) {
        this.accountNumber = accountNumber;
        this.customerName = customerName;
        this.balance = balance;
    }

    public int getAccountNumber() {
        return accountNumber;
    }

    public String getCustomerName() {
        return customerName;
    }

    public double getBalance() {
        return balance;
    }

    public ArrayList<Transaction> getTransactions() {
        return transactions;
    }

    public void deposit(double amount, int id) {
        balance += amount;
        transactions.add(
            new Transaction(id, "DEPOSIT", amount)
        );
    }

    public boolean withdraw(double amount, int id) {
        if (amount <= 0 || amount > balance) {
            return false;
        }

        balance -= amount;
        transactions.add(
            new Transaction(id, "WITHDRAW", amount)
        );

        return true;
    }

    public String toString() {
        return "Account No: " + accountNumber +
                " | Name: " + customerName +
                " | Balance: Rs. " + balance;
    }
}

// ================= BANK MANAGER CLASS =================

class BankManager {

    private HashMap<Integer, BankAccount> accounts =
            new HashMap<>();

    private int nextTransactionId = 1;

    public boolean createAccount(int accountNumber,
                                 String name,
                                 double balance) {

        if (accounts.containsKey(accountNumber) ||
                name == null || name.trim().isEmpty() ||
                balance < 0 || !Double.isFinite(balance)) {
            return false;
        }

        accounts.put(accountNumber,
                new BankAccount(accountNumber, name, balance));

        return true;
    }

    public BankAccount findAccount(int accountNumber) {
        return accounts.get(accountNumber);
    }

    public boolean deposit(int accountNumber, double amount) {
        BankAccount account = findAccount(accountNumber);

        if (account == null || amount <= 0 ||
                !Double.isFinite(amount)) {
            return false;
        }

        account.deposit(amount, nextTransactionId++);
        return true;
    }

    public boolean withdraw(int accountNumber, double amount) {
        BankAccount account = findAccount(accountNumber);

        if (account == null || amount <= 0 ||
                !Double.isFinite(amount) ||
                amount > account.getBalance()) {
            return false;
        }

        return account.withdraw(amount, nextTransactionId++);
    }

    public void displayAllAccounts() {
        if (accounts.isEmpty()) {
            System.out.println("No accounts available.");
            return;
        }

        for (BankAccount account : accounts.values()) {
            System.out.println(account);
        }
    }

    public void displayTransactions(int accountNumber) {
        BankAccount account = findAccount(accountNumber);

        if (account == null) {
            System.out.println("Account not found.");
            return;
        }

        ArrayList<Transaction> list =
                account.getTransactions();

        if (list.isEmpty()) {
            System.out.println("No transactions found.");
            return;
        }

        System.out.println("Transaction History:");

        for (Transaction t : list) {
            System.out.println(t);
        }
    }

    // Sort transactions by date
    public void sortTransactionsByDate(int accountNumber) {
        BankAccount account = findAccount(accountNumber);

        if (account == null) {
            System.out.println("Account not found.");
            return;
        }

        ArrayList<Transaction> sorted =
                new ArrayList<>(account.getTransactions());

        sorted.sort(
            Comparator.comparing(Transaction::getDate)
                .thenComparingInt(Transaction::getTransactionId)
        );

        System.out.println("Sorted by Date:");

        sorted.forEach(System.out::println);
    }

    // Sort transactions by amount
    public void sortTransactionsByAmount(int accountNumber) {
        BankAccount account = findAccount(accountNumber);

        if (account == null) {
            System.out.println("Account not found.");
            return;
        }

        ArrayList<Transaction> sorted =
                new ArrayList<>(account.getTransactions());

        sorted.sort(
            Comparator.comparingDouble(
                Transaction::getAmount
            ).reversed()
        );

        System.out.println("Sorted by Amount:");

        sorted.forEach(System.out::println);
    }

    public HashMap<Integer, BankAccount> getAccounts() {
        return accounts;
    }

    public void setAccounts(
            HashMap<Integer, BankAccount> accounts) {

        this.accounts = accounts;

        int maxId = 0;

        for (BankAccount account : accounts.values()) {
            for (Transaction t : account.getTransactions()) {
                maxId = Math.max(maxId, t.getTransactionId());
            }
        }

        nextTransactionId = maxId + 1;
    }
}

// ================= FILE HANDLER CLASS =================

class FileHandler {

    private static final String FILE_NAME = "bankdata.dat";

    // Object Serialization
    public static void saveAccounts(
            HashMap<Integer, BankAccount> accounts) {

        try (ObjectOutputStream output =
                new ObjectOutputStream(
                    new FileOutputStream(FILE_NAME))) {

            output.writeObject(accounts);

            System.out.println(
                "Account data saved successfully.");

        } catch (IOException e) {
            System.out.println(
                "Error saving data: " + e.getMessage());
        }
    }

    // Object Deserialization
    @SuppressWarnings("unchecked")
    public static HashMap<Integer, BankAccount> loadAccounts() {

        try (ObjectInputStream input =
                new ObjectInputStream(
                    new FileInputStream(FILE_NAME))) {

            HashMap<Integer, BankAccount> accounts =
                (HashMap<Integer, BankAccount>) input.readObject();

            System.out.println(
                "Account data loaded successfully.");

            return accounts;

        } catch (IOException | ClassNotFoundException e) {

            System.out.println(
                "No saved data found or unable to load.");

            return new HashMap<>();
        }
    }
}

// ================= MAIN CLASS =================

public class Main {

    private static Scanner sc = new Scanner(System.in);

    public static void main(String[] args) {

        BankManager manager = new BankManager();

        manager.setAccounts(FileHandler.loadAccounts());

        int choice;

        do {
            System.out.println("\n==================================");
            System.out.println(" BANKING ACCOUNT MANAGEMENT SYSTEM");
            System.out.println("==================================");

            System.out.println("1. Create Account");
            System.out.println("2. Display All Accounts");
            System.out.println("3. Search Account");
            System.out.println("4. Deposit Amount");
            System.out.println("5. Withdraw Amount");
            System.out.println("6. View Transaction History");
            System.out.println("7. Sort Transactions by Date");
            System.out.println("8. Sort Transactions by Amount");
            System.out.println("9. Save Account Data");
            System.out.println("10. Load Account Data");
            System.out.println("11. Exit");

            System.out.print("Enter your choice: ");

            try {
                choice = Integer.parseInt(sc.nextLine());
            } catch (NumberFormatException e) {
                System.out.println("Enter a valid choice.");
                continue;
            }

            switch (choice) {

                case 1:
                    System.out.print("Enter account number: ");
                    int accNo = Integer.parseInt(sc.nextLine());

                    System.out.print("Enter customer name: ");
                    String name = sc.nextLine();

                    System.out.print("Enter opening balance: ");
                    double balance =
                            Double.parseDouble(sc.nextLine());

                    if (manager.createAccount(accNo, name, balance)) {
                        System.out.println(
                            "Account created successfully.");
                    } else {
                        System.out.println(
                            "Account creation failed.");
                    }
                    break;

                case 2:
                    manager.displayAllAccounts();
                    break;

                case 3:
                    System.out.print("Enter account number: ");
                    accNo = Integer.parseInt(sc.nextLine());

                    BankAccount account =
                            manager.findAccount(accNo);

                    if (account != null) {
                        System.out.println(account);
                    } else {
                        System.out.println("Account not found.");
                    }
                    break;

                case 4:
                    System.out.print("Enter account number: ");
                    accNo = Integer.parseInt(sc.nextLine());

                    System.out.print("Enter deposit amount: ");
                    balance = Double.parseDouble(sc.nextLine());

                    if (manager.deposit(accNo, balance)) {
                        System.out.println("Deposit successful.");
                        System.out.println("Updated balance: Rs. " +
                                manager.findAccount(accNo).getBalance());
                    } else {
                        System.out.println("Deposit failed.");
                    }
                    break;

                case 5:
                    System.out.print("Enter account number: ");
                    accNo = Integer.parseInt(sc.nextLine());

                    System.out.print("Enter withdrawal amount: ");
                    balance = Double.parseDouble(sc.nextLine());

                    if (manager.withdraw(accNo, balance)) {
                        System.out.println("Withdrawal successful.");
                        System.out.println("Updated balance: Rs. " +
                                manager.findAccount(accNo).getBalance());
                    } else {
                        System.out.println(
                            "Withdrawal failed. Check balance.");
                    }
                    break;

                case 6:
                    System.out.print("Enter account number: ");
                    accNo = Integer.parseInt(sc.nextLine());

                    manager.displayTransactions(accNo);
                    break;

                case 7:
                    System.out.print("Enter account number: ");
                    accNo = Integer.parseInt(sc.nextLine());

                    manager.sortTransactionsByDate(accNo);
                    break;

                case 8:
                    System.out.print("Enter account number: ");
                    accNo = Integer.parseInt(sc.nextLine());

                    manager.sortTransactionsByAmount(accNo);
                    break;

                case 9:
                    FileHandler.saveAccounts(
                            manager.getAccounts());
                    break;

                case 10:
                    manager.setAccounts(
                            FileHandler.loadAccounts());
                    break;

                case 11:
                    FileHandler.saveAccounts(
                            manager.getAccounts());

                    System.out.println("Thank you. Goodbye!");
                    break;

                default:
                    System.out.println("Invalid choice.");
            }

        } while (choice != 11);

        sc.close();
    }
}
